APP_NAME="Smart Hospital & Office IT Management Platform"
ENVIRONMENT=production
SECRET_KEY=replace-with-at-least-32-random-characters-before-release
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=postgresql+asyncpg://smart_it:replace-me@postgres.internal:5432/smart_it
REDIS_URL=redis://redis.internal:6379/0
SCAN_INTERVAL_SECONDS=30
TRIAL_DAYS=14
TRIAL_MAX_DEVICES=10
TRIAL_REMOTE_SESSION_MINUTES=10
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
